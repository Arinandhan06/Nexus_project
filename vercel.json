{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/api/index.py" },
    { "source": "/chambers/(.*)", "destination": "/api/index.py" },
    { "source": "/me", "destination": "/api/index.py" },
    { "source": "/profile/(.*)", "destination": "/api/index.py" },
    { "source": "/finale/(.*)", "destination": "/api/index.py" },
    { "source": "/bids/(.*)", "destination": "/api/index.py" },
    { "source": "/trophy/(.*)", "destination": "/api/index.py" },
    { "source": "/community/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/ws/(.*)", "destination": "/api/index.py" },
    { "source": "/market-match", "destination": "/api/index.py" },
    { "source": "/foundry/(.*)", "destination": "/api/index.py" },
    { "source": "/dev/(.*)", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
